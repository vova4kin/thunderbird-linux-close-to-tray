{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.0.1",
  "author": "vevidi",
  "default_locale": "en",
  "homepage_url": "https://vevidi.com/",
  "browser_specific_settings": {
    "gecko": {
      "id": "close-to-tray-linux@vevidi.com",
      "strict_min_version": "128.0",
      "strict_max_version": "160.*"
    }
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "permissions": [
    "accountsRead",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "experiment_apis": {
    "trayWindow": {
      "schema": "experiments/trayWindow/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["trayWindow"]],
        "script": "experiments/trayWindow/implementation.js"
      }
    },
    "systemTray": {
      "schema": "experiments/systemTray/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["systemTray"]],
        "script": "experiments/systemTray/implementation.js"
      }
    }
  }
}
